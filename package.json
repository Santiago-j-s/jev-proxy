{
  "name": "jev-proxy",
  "version": "0.1.0",
  "description": "A local observability proxy for TypeSafe Jev requests",
  "type": "module",
  "bin": {
    "jev-proxy": "dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json && npm run build:editor",
    "build:editor": "esbuild browser/codemirror.js --bundle --format=esm --minify --outfile=public/codemirror.js",
    "dev": "npm run build:editor && tsx src/cli.ts start",
    "start": "node dist/cli.js start",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json",
    "test": "npm run build:editor && node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@lezer/common": "^1.5.2",
    "codemirror": "^6.0.2"
  }
}
