{
  "name": "jev-proxy",
  "version": "0.1.0",
  "description": "A local observability proxy for TypeSafe Jev requests",
  "type": "module",
  "bin": {
    "jev-proxy": "src/cli.ts"
  },
  "files": [
    "src",
    "browser",
    "public",
    "docs",
    "README.md"
  ],
  "scripts": {
    "dev": "NODE_ENV=development bun --watch src/cli.ts start",
    "start": "bun src/cli.ts start",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json",
    "test": "bun test test/*.test.ts"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@lezer/common": "^1.5.2",
    "codemirror": "^6.0.2"
  }
}
