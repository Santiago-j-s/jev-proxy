{
  "name": "jev-proxy",
  "version": "0.1.0",
  "description": "A local observability proxy for TypeSafe Jev requests",
  "type": "module",
  "bin": {
    "jev-proxy": "dist/cli.js"
  },
  "files": [
    "dist",
    "public",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts start",
    "start": "node dist/cli.js start",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
